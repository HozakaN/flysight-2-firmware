+/* DIAG: cuts the power of the card for a chosen time between two mounts, and records
+ * whether the second mount works. Runs once at start-up, before the BLE stack. */
+volatile struct
+{
+	uint32_t done;
+	uint32_t count;
+	struct
+	{
+		uint32_t gap_us;
+		uint8_t  fr_before;  /* mount after a long rest */
+		uint8_t  fr_after;   /* mount after the gap */
+		uint8_t  stage;
+		uint8_t  tries;
+		uint8_t  r1;
+		uint8_t  sdhc;       /* card type seen by the second mount */
+		uint8_t  hs;         /* result of the high-speed switch of the second mount */
+		uint8_t  sdhc_before;
+	} log[128];
+} fs_sweep;
+
+static uint8_t diag_mount(void)
+{
+	FRESULT fr = FR_INT_ERR;
+	if (FS_ResourceManager_RequestResource(FS_RESOURCE_MICROSD) == FS_RESOURCE_MANAGER_SUCCESS)
+	{
+		MX_FATFS_Init();
+		fr = f_mount(&fs, "0:/", 1);
+	}
+	return fr;
+}
+
+static void diag_unmount(void)
+{
+	f_mount(0, "0:/", 0);
+	MX_FATFS_DeInit();
+	FS_ResourceManager_ReleaseResource(FS_RESOURCE_MICROSD);
+}
+
+static void diag_wait_us(uint32_t us)
+{
+	uint32_t start = DWT->CYCCNT;
+	uint32_t cycles = (SystemCoreClock / 1000000U) * us;
+	while ((DWT->CYCCNT - start) < cycles);
+}
+
+void FS_Diag_Sweep(void)
+{
+	static const uint32_t gaps[] = {0, 50, 100, 200, 300, 400, 500, 700, 1000, 1300, 1600, 2000,
+			2500, 3000, 4000, 5000, 7000, 10000, 20000, 45000};
+	uint32_t pass, i, n;
+
+	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
+	DWT->CYCCNT = 0;
+	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
+
+	for (pass = 0; pass < 6; ++pass)
+	{
+		for (i = 0; i < sizeof(gaps) / sizeof(gaps[0]); ++i)
+		{
+			n = fs_sweep.count;
+
+			/* Long rest without power, then a first mount */
+			HAL_Delay(2000);
+			fs_sweep.log[n].fr_before = diag_mount();
+			fs_sweep.log[n].sdhc_before = sd_diag_sdhc;
+			diag_unmount();
+
+			if (gaps[i] > 0)
+			{
+				diag_wait_us(gaps[i]);
+			}
+
+			fs_sweep.log[n].gap_us = gaps[i];
+			fs_sweep.log[n].fr_after = diag_mount();
+			fs_sweep.log[n].stage = sd_diag_stage;
+			fs_sweep.log[n].tries = sd_diag_tries;
+			fs_sweep.log[n].r1 = sd_diag_r1;
+			fs_sweep.log[n].sdhc = sd_diag_sdhc;
+			fs_sweep.log[n].hs = sd_diag_hs;
+			diag_unmount();
+
+			fs_sweep.count = n + 1;
+		}
+	}
+	fs_sweep.done = 1;
+}
